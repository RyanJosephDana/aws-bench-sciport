{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "instanceId": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-InstanceId"
      },
      "Value": {
        "Fn::GetAtt": [
          "server",
          "InstanceId"
        ]
      }
    },
    "numEc2Running": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-NUMEC2Running"
      },
      "Value": "1"
    },
    "privateIp": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-PrivateIPOfInstance"
      },
      "Value": {
        "Fn::GetAtt": [
          "server",
          "PrivateIp"
        ]
      }
    },
    "publicSubnetId": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-PublicSubnetId"
      },
      "Value": {
        "Fn::GetAtt": [
          "publicSubnet",
          "SubnetId"
        ]
      }
    },
    "stackId": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-StackId"
      },
      "Value": {
        "Fn::Sub": "${AWS::StackId}"
      }
    },
    "vpcId": {
      "Export": {
        "Name": "ec2-multiregion-EC2-ls9fuhb522-us-west-2-VpcId"
      },
      "Value": {
        "Fn::GetAtt": [
          "vpc",
          "VpcId"
        ]
      }
    }
  },
  "Resources": {
    "defaultRoute": {
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Fn::GetAtt": [
            "igw",
            "InternetGatewayId"
          ]
        },
        "RouteTableId": {
          "Fn::GetAtt": [
            "routeTable",
            "RouteTableId"
          ]
        }
      },
      "Type": "AWS::EC2::Route"
    },
    "igw": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "igwAttachment": {
      "Properties": {
        "InternetGatewayId": {
          "Fn::GetAtt": [
            "igw",
            "InternetGatewayId"
          ]
        },
        "VpcId": {
          "Fn::GetAtt": [
            "vpc",
            "VpcId"
          ]
        }
      },
      "Type": "AWS::EC2::VPCGatewayAttachment"
    },
    "publicSubnet": {
      "Properties": {
        "CidrBlock": "10.0.0.0/24",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Public"
          }
        ],
        "VpcId": {
          "Fn::GetAtt": [
            "vpc",
            "VpcId"
          ]
        }
      },
      "Type": "AWS::EC2::Subnet"
    },
    "routeTable": {
      "Properties": {
        "VpcId": {
          "Fn::GetAtt": [
            "vpc",
            "VpcId"
          ]
        }
      },
      "Type": "AWS::EC2::RouteTable"
    },
    "server": {
      "Properties": {
        "ImageId": "ami-0f3f13f145e66a0a3",
        "InstanceType": "t3.micro",
        "SubnetId": {
          "Fn::GetAtt": [
            "publicSubnet",
            "SubnetId"
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "WebServerInstance"
          }
        ]
      },
      "Type": "AWS::EC2::Instance"
    },
    "subnetRouteAssoc": {
      "Properties": {
        "RouteTableId": {
          "Fn::GetAtt": [
            "routeTable",
            "RouteTableId"
          ]
        },
        "SubnetId": {
          "Fn::GetAtt": [
            "publicSubnet",
            "SubnetId"
          ]
        }
      },
      "Type": "AWS::EC2::SubnetRouteTableAssociation"
    },
    "vpc": {
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "ResourcesVpc"
          }
        ]
      },
      "Type": "AWS::EC2::VPC"
    }
  }
}
