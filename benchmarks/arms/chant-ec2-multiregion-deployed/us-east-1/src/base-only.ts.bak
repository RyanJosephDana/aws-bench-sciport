// Region us-east-1 (primary) — deployed by chant under the stack name
// "ec2-multiregion-EC2-ks84v1fh12-us-east-1" (the scenario's original name).
//
// Custom VPC (public + isolated private subnet), four t3.micro instances
// (public web server with IAM profile, launch-template instance, private
// instance, default-VPC instance), the open web security group, a
// deliberately unused security group, and the launch template. The AMI
// ("ami-<account>-us-east-1") is baked from the web server by the deploy op
// after the stack settles. Default-VPC ids arrive as parameters, resolved by
// the deployer from the live account.

import {
  Instance,
  InternetGateway,
  LaunchTemplate,
  EC2Route,
  RouteTable,
  Role,
  InstanceProfile,
  SecurityGroup,
  Subnet,
  SubnetRouteTableAssociation,
  Vpc,
  VPCGatewayAttachment,
  Parameter,
  Sub,
  Ref,
  AWS,
  stackOutput,
} from "@intentius/chant-lexicon-aws";

const AL2023 = "ami-0f3f13f145e66a0a3";
const T3_MICRO = "t3.micro";
const STACK = "ec2-multiregion-EC2-ks84v1fh12-us-east-1";

// ── Deploy-time parameters: the live account's default VPC ────────────────
export const defaultVpcId = new Parameter("AWS::EC2::VPC::Id", {
  description: "The account's default VPC id",
});
export const defaultSubnetId1 = new Parameter("AWS::EC2::Subnet::Id", {
  description: "First public subnet of the default VPC",
});
export const defaultSubnetId2 = new Parameter("AWS::EC2::Subnet::Id", {
  description: "Second public subnet of the default VPC",
});

// ── Custom VPC and subnets ────────────────────────────────────────────────
export const vpc = new Vpc({
  CidrBlock: "10.0.0.0/16",
  EnableDnsSupport: true,
  EnableDnsHostnames: true,
  Tags: [{ Key: "Name", Value: "ResourcesVpc" }],
});

export const publicSubnet = new Subnet({
  VpcId: vpc.VpcId,
  CidrBlock: "10.0.0.0/24",
  MapPublicIpOnLaunch: true,
  Tags: [{ Key: "Name", Value: "Public" }],
});

export const privateSubnet = new Subnet({
  VpcId: vpc.VpcId,
  CidrBlock: "10.0.1.0/24",
  MapPublicIpOnLaunch: false,
  Tags: [{ Key: "Name", Value: "Private" }],
});

export const igw = new InternetGateway({});
export const igwAttachment = new VPCGatewayAttachment({
  VpcId: vpc.VpcId,
  InternetGatewayId: igw.InternetGatewayId,
});
export const publicRouteTable = new RouteTable({ VpcId: vpc.VpcId });
export const publicDefaultRoute = new EC2Route({
  RouteTableId: publicRouteTable.RouteTableId,
  DestinationCidrBlock: "0.0.0.0/0",
  GatewayId: igw.InternetGatewayId,
});
export const publicSubnetRouteAssoc = new SubnetRouteTableAssociation({
  RouteTableId: publicRouteTable.RouteTableId,
  SubnetId: publicSubnet.SubnetId,
});

// ── Security groups ───────────────────────────────────────────────────────
// SSH/HTTP/HTTPS open to the world — the scenario's deliberate exposure.
export const webSecurityGroup = new SecurityGroup({
  GroupDescription: "Allow specific inbound traffic",
  VpcId: vpc.VpcId,
  SecurityGroupIngress: [
    { IpProtocol: "tcp", FromPort: 22, ToPort: 22, CidrIp: "0.0.0.0/0", Description: "Allow SSH access" },
    { IpProtocol: "tcp", FromPort: 80, ToPort: 80, CidrIp: "0.0.0.0/0", Description: "Allow HTTP access" },
    { IpProtocol: "tcp", FromPort: 443, ToPort: 443, CidrIp: "0.0.0.0/0", Description: "Allow HTTPS access" },
  ],
});

// Attached to nothing, on purpose.
export const unusedSecurityGroup = new SecurityGroup({
  GroupDescription: "Unused security group",
  VpcId: vpc.VpcId,
});

// ── IAM ───────────────────────────────────────────────────────────────────
export const instanceRole = new Role({
  RoleName: Sub`role-${AWS.AccountId}-${AWS.Region}`,
  AssumeRolePolicyDocument: {
    Version: "2012-10-17",
    Statement: [
      { Effect: "Allow", Principal: { Service: "ec2.amazonaws.com" }, Action: "sts:AssumeRole" },
    ],
  },
  ManagedPolicyArns: ["arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"],
  Policies: [
    {
      PolicyName: Sub`policy-${AWS.AccountId}-${AWS.Region}`,
      PolicyDocument: {
        Version: "2012-10-17",
        Statement: [
          {
            Effect: "Deny",
            Action: ["ec2:ModifyInstanceAttribute", "ec2:ModifyInstanceMetadataOptions"],
            Resource: "*",
          },
        ],
      },
    },
  ],
});

export const instanceProfile = new InstanceProfile({
  InstanceProfileName: Sub`instanceprofile-${AWS.AccountId}-${AWS.Region}`,
  Roles: [Ref(instanceRole)],
});

// ── Instances ─────────────────────────────────────────────────────────────
export const webServer = new Instance({
  SubnetId: publicSubnet.SubnetId,
  SecurityGroupIds: [webSecurityGroup.GroupId],
  InstanceType: T3_MICRO,
  ImageId: AL2023,
  IamInstanceProfile: Ref(instanceProfile),
  Tags: [{ Key: "Name", Value: "WebServerInstance" }],
});

export const launchTemplate = new LaunchTemplate({
  LaunchTemplateName: Sub`lt-${AWS.AccountId}-${AWS.Region}`,
  LaunchTemplateData: {
    InstanceType: T3_MICRO,
    ImageId: AL2023,
    SecurityGroupIds: [webSecurityGroup.GroupId],
    BlockDeviceMappings: [{ DeviceName: "/dev/xvda", Ebs: { VolumeSize: 8, VolumeType: "gp3" } }],
    MetadataOptions: { HttpTokens: "required" },
  },
});

export const launchTemplateServer = new Instance({
  LaunchTemplate: { LaunchTemplateId: launchTemplate.LaunchTemplateId, Version: "1" },
  SubnetId: publicSubnet.SubnetId,
  Tags: [{ Key: "Name", Value: "LaunchTemplateInstance" }],
});

// Private isolated subnet — must not appear in public-reachability answers.
export const privateServer = new Instance({
  SubnetId: privateSubnet.SubnetId,
  InstanceType: T3_MICRO,
  ImageId: AL2023,
  Tags: [{ Key: "Name", Value: "PrivateInstance" }],
});

// The account's default VPC (parameterized subnet).
export const defaultVpcServer = new Instance({
  SubnetId: Ref(defaultSubnetId1),
  InstanceType: T3_MICRO,
  ImageId: AL2023,
  Tags: [{ Key: "Name", Value: "MyEC2Instance" }],
});

// ── Export contract (27 exports, names identical to the scenario's) ──────
export const expPrivateInstanceId = stackOutput(privateServer.InstanceId, {
  exportName: `${STACK}-PrivateInstanceId`,
});
export const expPrivateInstanceIp = stackOutput(privateServer.PrivateIp, {
  exportName: `${STACK}-PrivateInstancePrivateIp`,
});
export const expRoleName = stackOutput(instanceRole.RoleName, {
  exportName: `${STACK}-RoleName`,
});
export const expVpcId = stackOutput(vpc.VpcId, { exportName: `${STACK}-VpcId` });
export const expRestrictedAttr = stackOutput("ec2:ModifyInstanceAttribute", {
  lexicon: "aws",
  exportName: `${STACK}-RestrictedActionModifyInstanceAttribute`,
});
export const expRestrictedMeta = stackOutput("ec2:ModifyInstanceMetadataOptions", {
  lexicon: "aws",
  exportName: `${STACK}-RestrictedActionModifyInstanceMetadataOptions`,
});
export const expSecurityGroupId = stackOutput(webSecurityGroup.GroupId, {
  exportName: `${STACK}-SecurityGroupId`,
});
export const expUnusedSecurityGroupId = stackOutput(unusedSecurityGroup.GroupId, {
  exportName: `${STACK}-UnusedSecurityGroupId`,
});
export const expPublicSubnetId = stackOutput(publicSubnet.SubnetId, {
  exportName: `${STACK}-PublicSubnetId`,
});
export const expInstanceProfileName = stackOutput(instanceProfile.InstanceProfileName, {
  exportName: `${STACK}-InstanceProfileName`,
});
export const expAmiName = stackOutput(Sub`ami-${AWS.AccountId}-${AWS.Region}`, {
  lexicon: "aws",
  exportName: `${STACK}-AMIName`,
});
export const expInstanceId = stackOutput(webServer.InstanceId, {
  exportName: `${STACK}-InstanceId`,
});
export const expLaunchTemplateInstanceId = stackOutput(launchTemplateServer.InstanceId, {
  exportName: `${STACK}-LaunchTemplateInstanceId`,
});
export const expNumEc2 = stackOutput("4", {
  lexicon: "aws",
  exportName: `${STACK}-NUMEC2Running`,
});
export const expNumSubnets = stackOutput("1", {
  lexicon: "aws",
  exportName: `${STACK}-NUMSubnets`,
});
export const expSshPort = stackOutput("22", {
  lexicon: "aws",
  exportName: `${STACK}-OpenSSHPort`,
});
export const expHttpPort = stackOutput("80", {
  lexicon: "aws",
  exportName: `${STACK}-OpenHTTPPort`,
});
export const expHttpsPort = stackOutput("443", {
  lexicon: "aws",
  exportName: `${STACK}-OpenHTTPsPort`,
});
export const expStackName = stackOutput(STACK, {
  lexicon: "aws",
  exportName: `${STACK}-StackName`,
});
export const expStackId = stackOutput(Sub`${AWS.StackId}`, {
  lexicon: "aws",
  exportName: `${STACK}-StackId`,
});
export const expWebIp = stackOutput(webServer.PrivateIp, {
  exportName: `${STACK}-PrivateIPOfInstanceWithoutLaunchTemplate`,
});
export const expLtIp = stackOutput(launchTemplateServer.PrivateIp, {
  exportName: `${STACK}-PrivateIPOfInstanceWithLaunchTemplate`,
});
// The three parameter-echo exports (DefaultVpcId, DefaultPublicSubnetId1/2)
// are injected by the deploy script post-build — stackOutput(Ref(param)) is
// blocked by INTENTIUS/chant#1152; the deployer owns the values anyway.
export const expDefaultVpcInstanceId = stackOutput(defaultVpcServer.InstanceId, {
  exportName: `${STACK}-DefaultVPCInstanceId`,
});
export const expDefaultVpcInstanceIp = stackOutput(defaultVpcServer.PrivateIp, {
  exportName: `${STACK}-PrivateIPOfInstanceWithDefaultVpc`,
});
